<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <config>
    <!-- Пакеты лежат рядом с репозиторием, на том же диске, а не в профиле пользователя на системном диске. Путь отсчитывается от этого файла -->
    <add key="globalPackagesFolder" value="..\.nuget\packages" />
  </config>
</configuration>
