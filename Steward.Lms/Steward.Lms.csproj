<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Steward.Lms</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.52.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Steward.Homework\Steward.Homework.csproj" />
    <ProjectReference Include="..\Steward.Status\Steward.Status.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="lmssettings.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('lmssettings.json')" />
  </ItemGroup>

  <!-- Проект подтягивает Steward.Mail через Steward.Homework, а тот несёт свой appsettings.json с паролем почты. В публикацию он не нужен -->
  <Target Name="DropMailSettings" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'appsettings.json' And $([System.String]::Copy('%(FullPath)').Contains('Steward.Mail'))" />
    </ItemGroup>
  </Target>

</Project>
