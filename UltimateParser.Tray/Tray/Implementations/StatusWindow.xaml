<Window x:Class="UltimateParser.Tray.Tray.Implementations.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:UltimateParser.Tray.Monitoring.Models"
        xmlns:ui="clr-namespace:UltimateParser.Tray.Tray.Models"
        xmlns:views="clr-namespace:UltimateParser.Tray.Tray.Views"
        Title="Расписание"
        Width="540"
        Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Storyboard x:Key="GlowPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                             From="0.35" To="1" Duration="0:0:1.4"/>
        </Storyboard>
    </Window.Resources>

    <Border CornerRadius="22" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="16">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#2A2144" Offset="0"/>
                <GradientStop Color="#1C1630" Offset="0.28"/>
                <GradientStop Color="#1C1630" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,18,20,8">
                <Grid x:Name="Header" MouseLeftButtonDown="Header_OnDrag">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="52" Height="52" Margin="0,0,14,0" VerticalAlignment="Top">
                        <Ellipse x:Name="Glow" Fill="#8B6CFF" Opacity="0.45">
                            <Ellipse.Effect>
                                <BlurEffect Radius="18"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="14" Margin="4">
                            <Grid>
                                <Border Width="22" Height="16" BorderBrush="White" BorderThickness="1.6" CornerRadius="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <Rectangle Width="2" Height="6" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,10,0,0"/>
                                <Rectangle Width="2" Height="6" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,16,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Расписание" Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="2" CornerRadius="12" Padding="12,6" VerticalAlignment="Top" Margin="12,6,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelTone.Running}">
                                        <Setter Property="Background" Value="#203A34"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelTone.Problem}">
                                        <Setter Property="Background" Value="{StaticResource DangerSurfaceBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusLabel}" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource IdleBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelTone.Running}">
                                            <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelTone.Problem}">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Summary}" Margin="0,14,0,4" Foreground="{StaticResource TextBrush}" FontSize="15" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ScrollViewer x:Name="JournalScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,0,12,8">
                        <StackPanel>
                            <TextBlock Text="История сверок" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="8,4,0,10"/>
                            <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource MutedBrush}" FontSize="14"
                                       Margin="8,24,8,24" TextWrapping="Wrap"
                                       Visibility="{Binding IsJournalEmpty, Converter={StaticResource BoolToVisibility}}"/>
                            <ItemsControl ItemsSource="{Binding Cards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,0,8,12">
                                            <TextBlock Text="{Binding Day}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="4,0,0,8">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowDay}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border x:Name="Card" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="16,14" BorderThickness="1" BorderBrush="Transparent">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="#080612"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="Bar" Width="4" CornerRadius="2" Background="{StaticResource LineBrush}" Margin="0,2,12,2"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock x:Name="Time" Text="{Binding Time}" Foreground="{StaticResource LineBrush}" FontSize="13"/>
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="{StaticResource RaisedBrush}"/>
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#668B6CFF"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:LogTone.Update}">
                                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                <Setter TargetName="Time" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:LogTone.Problem}">
                                                <Setter TargetName="Card" Property="Background" Value="{StaticResource DangerSurfaceBrush}"/>
                                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource DangerBrush}"/>
                                                <Setter TargetName="Time" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,0,8,8">
                        <StackPanel>
                            <TextBlock Text="{Binding SettingsMessage}" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,4"/>

                            <TextBlock Text="Интервал сверки" Style="{StaticResource FieldTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Сколько минут ждать между проверками таблицы. Ползунок и число — одно и то же значение, от 1 до 180. После сохранения контейнер перезапускается и начинает ходить с новым интервалом."/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <views:IntervalBar VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Value="{Binding IntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource Field}" TextAlignment="Center"
                                         Text="{Binding MinutesText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <TextBlock Text="Название проекта" Style="{StaticResource FieldTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Имя проекта в Singularity, куда записываются занятия. Сервис ищет проект с этим названием и не создаёт новый, если такого нет."/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding ProjectTitle, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Колонка группы" Style="{StaticResource FieldTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Заголовок столбца на листе, из которого берутся ваши пары. Пишите его так же, как в таблице, например РКИ-2-26."/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding GroupColumn, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Часовой пояс таблицы" Style="{StaticResource FieldTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Пояс, в котором в таблице указано время начала пар. Для этой таблицы оставьте Europe/Moscow: время в ней московское, даже если на компьютере другой пояс."/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding TimeZone, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Идентификатор таблицы" Style="{StaticResource FieldTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Часть ссылки на Google Таблицу между /d/ и /edit. По ней сервис скачивает расписание."/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding SpreadsheetId, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Номер листа" Style="{StaticResource FieldTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Число gid из адреса вкладки. Это не название листа, а номер вкладки внутри файла."/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding SheetGid, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Токен Singularity" Style="{StaticResource FieldTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Ключ, по которому сервис входит в ваш аккаунт. Здесь уже лежит значение из файла настроек, на экране оно закрыто точками. Если выпустите новый ключ, вставьте его вместо текущего и сохраните."/>
                            <PasswordBox Style="{StaticResource SecretField}"
                                         views:PasswordBinding.Password="{Binding Token, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,4,20,10">
                        <Button Content="Сохранить и перезапустить" Style="{StaticResource ActionButton}" Command="{Binding SaveAndRestartCommand}"/>
                        <Button Content="Перезапустить" Style="{StaticResource ActionButton}" Command="{Binding RestartCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="16,0,16,8" Padding="4,6">
                <DockPanel LastChildFill="False">
                    <Button Content="{Binding ModeCaption}" Style="{StaticResource GhostButton}" DockPanel.Dock="Left" Command="{Binding ToggleSettingsCommand}"/>
                    <Button Content="Выход" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Command="{Binding ExitCommand}"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
