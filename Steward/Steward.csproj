<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon />
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Окна WPF, поэтому DPI задан в манифесте, а не через WinForms-свойство, о котором предупреждает WFO0003 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Steward.Schedule.Shared\Steward.Schedule.Shared.csproj" />
    <ProjectReference Include="..\Steward.Status\Steward.Status.csproj" />
  </ItemGroup>

</Project>
