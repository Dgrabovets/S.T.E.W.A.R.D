<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\steward.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Окна WPF, поэтому DPI задан в манифесте, а не через WinForms-свойство, о котором предупреждает WFO0003 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\steward.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Steward.Ideas\Steward.Ideas.csproj" />
    <ProjectReference Include="..\Steward.Schedule.Shared\Steward.Schedule.Shared.csproj" />
    <ProjectReference Include="..\Steward.Homework\Steward.Homework.csproj" />
    <ProjectReference Include="..\Steward.Status\Steward.Status.csproj" />
  </ItemGroup>

</Project>
