<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Цвета. Единственное место, где записаны шестнадцатеричные значения. Остальной код берёт кисти и цвета по имени -->

    <!-- Поверхности: от самой тёмной к самой светлой -->
    <Color x:Key="WindowColor">#0F172A</Color>
    <Color x:Key="WindowTopColor">#1E293B</Color>
    <Color x:Key="SurfaceColor">#1B2336</Color>
    <Color x:Key="RaisedColor">#273449</Color>

    <!-- Линии: Line только разделяет, LineStrong обводит поля ввода и держит контраст 3:1 -->
    <Color x:Key="LineColor">#334155</Color>
    <Color x:Key="LineStrongColor">#64748B</Color>

    <!-- Текст -->
    <Color x:Key="TextColor">#F8FAFC</Color>
    <Color x:Key="MutedColor">#A9B6C9</Color>

    <!-- Акцент: заливка кнопок, его вариант для текста и колец на тёмном фоне, текст на заливке -->
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="AccentHoverColor">#1D4ED8</Color>
    <Color x:Key="AccentPressedColor">#1E40AF</Color>
    <Color x:Key="AccentTextColor">#60A5FA</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>

    <!-- Состояния задач: цвет и тёмная подложка под ним -->
    <Color x:Key="OkColor">#22C55E</Color>
    <Color x:Key="OkSurfaceColor">#12301F</Color>
    <Color x:Key="AttentionColor">#FBBF24</Color>
    <Color x:Key="AttentionSurfaceColor">#3A2F12</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="DangerSurfaceColor">#3B1D24</Color>
    <Color x:Key="IdleColor">#94A3B8</Color>
    <Color x:Key="WorkingColor">#60A5FA</Color>

    <!-- Тень -->
    <Color x:Key="ShadowColor">#020617</Color>

    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrongColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>
    <SolidColorBrush x:Key="AccentOutlineBrush" Color="{StaticResource AccentTextColor}" Opacity="0.4"/>
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}"/>
    <SolidColorBrush x:Key="OkSurfaceBrush" Color="{StaticResource OkSurfaceColor}"/>
    <SolidColorBrush x:Key="AttentionBrush" Color="{StaticResource AttentionColor}"/>
    <SolidColorBrush x:Key="AttentionSurfaceBrush" Color="{StaticResource AttentionSurfaceColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{StaticResource DangerSurfaceColor}"/>
    <SolidColorBrush x:Key="IdleBrush" Color="{StaticResource IdleColor}"/>
    <SolidColorBrush x:Key="WorkingBrush" Color="{StaticResource WorkingColor}"/>

    <LinearGradientBrush x:Key="WindowGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource WindowTopColor}" Offset="0"/>
        <GradientStop Color="{StaticResource WindowColor}" Offset="0.25"/>
        <GradientStop Color="{StaticResource WindowColor}" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>