<Window x:Class="Steward.Views.RedoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="S.T.E.W.A.R.D"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource FontBase}"
        Width="560"
        SizeToContent="Height"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Border Style="{StaticResource WindowChrome}">
        <StackPanel Margin="24,18,24,20">
            <Grid Background="Transparent" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Переделать задание" Style="{StaticResource TextHeadline}"/>
                    <TextBlock x:Name="Heading" Style="{StaticResource TextCaption}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Click="Cancel_OnClick" Style="{StaticResource IconButton}" VerticalAlignment="Top" ToolTip="Закрыть">
                    <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18"/>
                </Button>
            </Grid>

            <TextBlock Style="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,14,0,0"
                       Text="Claude заново подготовит все несданные задания этого занятия. Нынешние работы, в том числе прикреплённая тобой, перейдут в папку .previous и останутся там как прежняя версия."/>

            <TextBlock Text="Что не понравилось" Style="{StaticResource TextCaption}" Margin="0,16,0,6"/>
            <TextBox x:Name="Remarks" Style="{StaticResource Field}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="240"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0"
                     AutomationProperties.Name="Что не понравилось"
                     ToolTip="Например: слишком много воды, переписать вывод, добавить таблицу"/>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Вид замечания" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="Kind" Grid.Column="1" Style="{StaticResource FieldChoice}" Width="160" Margin="0"
                          AutomationProperties.Name="Вид замечания" ToolTip="К чему относится замечание: так его проще найти и поправить во вкладке «Замечания»">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox x:Name="ForAll" Grid.Column="2" Content="Для всех предметов" HorizontalAlignment="Right" VerticalAlignment="Center"
                          AutomationProperties.Name="Для всех предметов"
                          ToolTip="Без галочки замечание учитывается только в этом предмете. Область можно сменить позже во вкладке «Замечания» окна указаний"/>
            </Grid>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Прикрепить файл" Click="Attach_OnClick" Style="{StaticResource OutlineButton}" Margin="0"
                        ToolTip="Замечания преподавателя файлом: Word, презентация, PDF, текст или снимок"/>
                <TextBlock x:Name="Attached" Grid.Column="1" Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
            <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Claude получит прежнюю версию, твои замечания и файлы и сделает работу заново. Замечание запомнится и будет учтено в следующих работах. Продиктовать можно голосом: нажми Win+H и говори."/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Отмена" Click="Cancel_OnClick" IsCancel="True" Style="{StaticResource GhostButton}"/>
                <Button Content="Переделать" Click="Confirm_OnClick" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
