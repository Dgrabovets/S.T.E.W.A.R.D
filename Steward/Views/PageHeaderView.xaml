<UserControl x:Class="Steward.Views.PageHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="SettingsToggle" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
            <Setter Property="Content" Value="Настройки"/>
            <Setter Property="Command" Value="{Binding ToggleSettingsCommand}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                    <Setter Property="Content" Value="Закрыть настройки"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="4,0,0,8" LastChildFill="True">
        <Button DockPanel.Dock="Right" Style="{StaticResource SettingsToggle}" VerticalAlignment="Center"/>
        <TextBlock DockPanel.Dock="Left" Text="{Binding Title, ElementName=Root}" Style="{StaticResource TextHeadline}" VerticalAlignment="Center"/>
        <ItemsControl ItemsSource="{Binding Chips, ElementName=Root}" Margin="16,0,12,-8" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ToneBadge}" Padding="12,5" Margin="0,0,8,8">
                        <TextBlock Text="{Binding Text}" Style="{StaticResource ToneBadgeText}"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
