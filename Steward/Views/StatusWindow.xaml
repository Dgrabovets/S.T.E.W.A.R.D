<Window x:Class="Steward.Views.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Steward.Behaviors"
        xmlns:controls="clr-namespace:Steward.Controls"
        xmlns:models="clr-namespace:Steward.Monitoring.Models"
        xmlns:ui="clr-namespace:Steward.Models"
        Title="Расписание"
        Width="540"
        Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource FontBase}">
    <Window.Resources>
        <Storyboard x:Key="GlowPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                             From="0.35" To="1" Duration="0:0:1.4"/>
        </Storyboard>
    </Window.Resources>

    <Border Style="{StaticResource WindowChrome}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,20,20,8">
                <Grid x:Name="Header" MouseLeftButtonDown="Header_OnDrag">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="52" Height="52" Margin="0,0,16,0" VerticalAlignment="Top">
                        <Ellipse x:Name="Glow" Fill="{StaticResource AccentBrush}" Opacity="0.45">
                            <Ellipse.Effect>
                                <BlurEffect Radius="18"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="{StaticResource RadiusBadge}" Margin="4">
                            <Grid>
                                <Border Width="22" Height="16" BorderBrush="White" BorderThickness="1.6" CornerRadius="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <Rectangle Width="2" Height="6" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,12,0,0"/>
                                <Rectangle Width="2" Height="6" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Задачи" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeHeadline}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBody}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource ToneBadge}" Padding="12,8" VerticalAlignment="Top" Margin="12,8,0,0">
                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource ToneBadgeText}"/>
                    </Border>
                </Grid>
                <ItemsControl ItemsSource="{Binding Tasks}" Margin="0,16,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Control Width="14" Height="14" Style="{StaticResource ToneDot}" VerticalAlignment="Top" Margin="0,8,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Headline}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBodyLarge}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeCaption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ScrollViewer x:Name="JournalScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,0,12,8">
                        <StackPanel>
                            <TextBlock Text="История сверок расписания" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeCaption}" Margin="8,4,0,12"/>
                            <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBody}"
                                       Margin="8,24,8,24" TextWrapping="Wrap"
                                       Visibility="{Binding IsJournalEmpty, Converter={StaticResource BoolToVisibility}}"/>
                            <ItemsControl ItemsSource="{Binding Cards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,0,8,12">
                                            <TextBlock Text="{Binding Day}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBody}" Margin="4,0,0,8">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowDay}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border x:Name="Card" Style="{StaticResource Card}" Margin="0" Padding="16" BorderThickness="1" BorderBrush="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="Bar" Width="4" CornerRadius="2" Background="{StaticResource LineBrush}" Margin="0,2,12,2"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock x:Name="Time" Text="{Binding Time}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBody}"/>
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeBodyLarge}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="{StaticResource RaisedBrush}"/>
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentOutlineBrush}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:LogToneEnum.Update}">
                                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource AccentTextBrush}"/>
                                                <Setter TargetName="Time" Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:LogToneEnum.Problem}">
                                                <Setter TargetName="Card" Property="Background" Value="{StaticResource DangerSurfaceBrush}"/>
                                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource DangerBrush}"/>
                                                <Setter TargetName="Time" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,0,8,8">
                        <StackPanel>
                            <TextBlock Text="{Binding SettingsMessage}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" Margin="0,4,0,4"/>

                            <TextBlock Text="Интервал сверки" Style="{StaticResource FieldTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Сколько минут ждать между проверками таблицы. Ползунок и число — одно и то же значение, от 1 до 180. После сохранения контейнер перезапускается и начинает ходить с новым интервалом."/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <controls:IntervalBar VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Value="{Binding IntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource Field}" TextAlignment="Center"
                                         Text="{Binding MinutesText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <TextBlock Text="Название проекта" Style="{StaticResource FieldTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Имя проекта в Singularity, куда записываются занятия. Сервис ищет проект с этим названием и создаёт его, если такого нет."/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding ProjectTitle, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Колонка группы" Style="{StaticResource FieldTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Заголовок столбца на листе, из которого берутся ваши пары. Пишите его так же, как в таблице, например РКИ-2-26."/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding GroupColumn, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Часовой пояс таблицы" Style="{StaticResource FieldTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Пояс, в котором в таблице указано время начала пар. Для этой таблицы оставьте Europe/Moscow: время в ней московское, даже если на компьютере другой пояс."/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding TimeZone, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Идентификатор таблицы" Style="{StaticResource FieldTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Часть ссылки на Google Таблицу между /d/ и /edit. По ней сервис скачивает расписание."/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding SpreadsheetId, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Номер листа" Style="{StaticResource FieldTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Число gid из адреса вкладки. Это не название листа, а номер вкладки внутри файла."/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding SheetGid, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Токен Singularity" Style="{StaticResource FieldTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Ключ, по которому сервис входит в ваш аккаунт. Здесь уже лежит значение из файла настроек, на экране оно закрыто точками. Если выпустите новый ключ, вставьте его вместо текущего и сохраните."/>
                            <PasswordBox Style="{StaticResource SecretField}"
                                         behaviors:PasswordBinding.Password="{Binding Token, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,4,20,12">
                        <Button Content="Сохранить и перезапустить" Style="{StaticResource ActionButton}" Command="{Binding SaveAndRestartCommand}"/>
                        <Button Content="Перезапустить" Style="{StaticResource ActionButton}" Command="{Binding RestartCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="16,0,16,8" Padding="4,8">
                <DockPanel LastChildFill="False">
                    <Button Content="{Binding ModeCaption}" Style="{StaticResource GhostButton}" DockPanel.Dock="Left" Command="{Binding ToggleSettingsCommand}"/>
                    <Button Content="Приложение" Style="{StaticResource GhostButton}" DockPanel.Dock="Left" Command="{Binding OpenAppCommand}"/>
                    <Button Content="Выход" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Command="{Binding ExitCommand}"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
