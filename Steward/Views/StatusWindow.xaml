<views:TrayPopupWindow x:Class="Steward.Views.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Steward.Views"
        xmlns:behaviors="clr-namespace:Steward.Behaviors"
        xmlns:controls="clr-namespace:Steward.Controls"
        xmlns:models="clr-namespace:Steward.Monitoring.Models"
        xmlns:ui="clr-namespace:Steward.Models"
        Title="Расписание"
        Width="540"
        Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource FontBase}">
    <Window.Resources>
        <Storyboard x:Key="GlowPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                             From="0.35" To="1" Duration="0:0:1.4"/>
        </Storyboard>
    </Window.Resources>

    <Border Style="{StaticResource WindowChrome}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,20,20,8">
                <Grid x:Name="Header" MouseLeftButtonDown="Header_OnDrag">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="52" Height="52" Margin="0,0,16,0" VerticalAlignment="Top">
                        <Ellipse x:Name="Glow" Fill="{StaticResource AccentBrush}" Opacity="0.45">
                            <Ellipse.Effect>
                                <BlurEffect Radius="18"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Image Source="pack://application:,,,/Assets/steward.ico" Margin="4" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Сверки расписания" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeHeadline}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBody}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource ToneBadge}" Padding="8,4,12,4" VerticalAlignment="Top" Margin="12,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <controls:ActivityOrb Width="24" Height="24" Style="{StaticResource SummaryOrb}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource ToneBadgeText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
                
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid>
                    
                    <ScrollViewer x:Name="JournalScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,0,12,8">
                        <StackPanel>
                            <TextBlock Text="История сверок расписания" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeCaption}" Margin="10,4,0,12"/>
                            <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBody}"
                                       Margin="8,24,8,24" TextWrapping="Wrap"
                                       Visibility="{Binding IsJournalEmpty, Converter={StaticResource BoolToVisibility}}"/>
                            <ItemsControl ItemsSource="{Binding Cards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,0,8,12">
                                            <TextBlock Text="{Binding Day}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBody}" Margin="10,0,0,8">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowDay}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border x:Name="Card" Style="{StaticResource Card}" Margin="0" Padding="16" BorderThickness="1" BorderBrush="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="Bar" Width="4" CornerRadius="2" Background="{StaticResource LineBrush}" Margin="0,2,12,2"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock x:Name="Time" Text="{Binding Time}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBody}"/>
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeBodyLarge}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="{StaticResource RaisedBrush}"/>
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentOutlineBrush}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:LogToneEnum.Update}">
                                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource AccentTextBrush}"/>
                                                <Setter TargetName="Time" Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:LogToneEnum.Problem}">
                                                <Setter TargetName="Card" Property="Background" Value="{StaticResource DangerSurfaceBrush}"/>
                                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource DangerBrush}"/>
                                                <Setter TargetName="Time" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                
            </Grid>

            
        </Grid>
    </Border>
</views:TrayPopupWindow>
