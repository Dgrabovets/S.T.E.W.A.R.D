<Window x:Class="Steward.Views.SettingsWindow"
        Icon="pack://application:,,,/Assets/steward.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Steward.Behaviors"
        xmlns:controls="clr-namespace:Steward.Controls"
        Title="Настройки"
        Width="560"
        Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource FontBase}">
    <Border Style="{StaticResource WindowChrome}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="24,20,20,12" MouseLeftButtonDown="Header_OnDrag" Background="Transparent">
                <StackPanel>
                    <TextBlock Text="Настройки" Style="{StaticResource TextHeadline}"/>
                </StackPanel>
                <Button Content="Закрыть" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_OnClick"/>
            </Grid>

            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,12,8">
                        <StackPanel>
                            <TextBlock Text="{Binding SettingsMessage}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" Margin="0,4,0,4"/>

                            <TextBlock Text="Интервал сверки" Style="{StaticResource FieldTitle}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>
                                <controls:IntervalBar VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Value="{Binding IntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource Field}" TextAlignment="Center"
                                         Text="{Binding MinutesText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <TextBlock Text="Название проекта" Style="{StaticResource FieldTitle}"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding ProjectTitle, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Колонка группы" Style="{StaticResource FieldTitle}"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding GroupColumn, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Часовой пояс таблицы" Style="{StaticResource FieldTitle}"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding TimeZone, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Идентификатор таблицы" Style="{StaticResource FieldTitle}"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding SpreadsheetId, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Номер листа" Style="{StaticResource FieldTitle}"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding SheetGid, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Токен Singularity" Style="{StaticResource FieldTitle}"/>
                            <PasswordBox Style="{StaticResource SecretField}"
                                         behaviors:PasswordBinding.Password="{Binding Token, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="16,0,16,8" Padding="8,10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Сохранить и перезапустить" Style="{StaticResource PrimaryButton}" Command="{Binding SaveAndRestartCommand}"/>
                    <Button Content="Перезапустить" Style="{StaticResource ActionButton}" Command="{Binding RestartCommand}" Margin="8,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>