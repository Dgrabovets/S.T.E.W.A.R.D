<UserControl x:Class="Steward.Views.ScheduleSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Steward.Behaviors"
             xmlns:controls="clr-namespace:Steward.Controls"
             xmlns:views="clr-namespace:Steward.Views">
    <StackPanel>
            <TextBlock Text="{Binding SettingsMessage}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding HasSettingsMessage, Converter={StaticResource BoolToVisibility}}"/>

            <ToggleButton x:Name="ScheduleToggle" IsChecked="True" Visibility="Collapsed" Style="{StaticResource SectionToggle}" Margin="0,8,0,0">
                <TextBlock Text="Настройки" Style="{StaticResource TextTitle}"/>
            </ToggleButton>
            <controls:CollapsibleBody Style="{StaticResource CollapsibleBody}" IsOpen="{Binding IsChecked, ElementName=ScheduleToggle}">
            <StackPanel>
            <TextBlock Text="Интервал сверки" Style="{StaticResource FieldTitle}" Margin="0,8,0,4"/>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="Как часто сервис проверяет таблицу, в минутах: от 1 до 180. Ползунок и число меняют одно значение. После сохранения контейнер перезапускается с новым интервалом."/>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="96"/>
                </Grid.ColumnDefinitions>
                <controls:IntervalBar VerticalAlignment="Center" Margin="0,0,12,0"
                                      Value="{Binding IntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Column="1" Style="{StaticResource Field}" TextAlignment="Center"
                         Text="{Binding MinutesText, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <TextBlock Text="Название проекта" Style="{StaticResource FieldTitle}"/>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="Проект в Singularity, куда сервис кладёт занятия. Если проекта с таким названием нет, сервис его создаст."/>
            <TextBox Style="{StaticResource Field}" Text="{Binding ProjectTitle, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Колонка группы" Style="{StaticResource FieldTitle}"/>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="Заголовок столбца на листе, из которого берутся твои пары. Пиши его так же, как в таблице, например РКИ-2-26."/>
            <TextBox Style="{StaticResource Field}" Text="{Binding GroupColumn, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Часовой пояс таблицы" Style="{StaticResource FieldTitle}"/>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="В каком часовом поясе в таблице записано время начала пар. Сервис сам переводит его в твоё время, так что пояс компьютера указывать не нужно. Ниже видно, чем они отличаются."/>
            <ComboBox Style="{StaticResource FieldChoice}" ItemsSource="{Binding TimeZones}" SelectedValuePath="Id" SelectedValue="{Binding TimeZone, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="{Binding TimeZoneNote}" Foreground="{StaticResource AccentTextBrush}"/>

            <TextBlock Text="Идентификатор таблицы" Style="{StaticResource FieldTitle}"/>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="Часть ссылки на Google Таблицу между /d/ и /edit. По ней сервис скачивает расписание."/>
            <TextBox Style="{StaticResource Field}" Text="{Binding SpreadsheetId, UpdateSourceTrigger=PropertyChanged}"/>
            <ToggleButton x:Name="IdHelp" Style="{StaticResource InlineLink}" Content="Как определить?"/>
            <controls:CollapsibleBody Style="{StaticResource CollapsibleBody}" IsOpen="{Binding IsChecked, ElementName=IdHelp}">
                <StackPanel Margin="0,4,0,4">
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Открой таблицу в браузере, скопируй адрес из адресной строки и вставь сюда."/>
                    <TextBox Style="{StaticResource Field}" Text="{Binding SpreadsheetLink, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Определить идентификатор таблицы" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                            Command="{Binding DetectSpreadsheetCommand}"/>
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="{Binding SpreadsheetNote}" Margin="0,6,0,0"/>
                </StackPanel>
            </controls:CollapsibleBody>

            <TextBlock Text="Номер листа" Style="{StaticResource FieldTitle}"/>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="Число gid из адреса вкладки. Это не название листа, а номер вкладки внутри файла."/>
            <TextBox Style="{StaticResource Field}" Text="{Binding SheetGid, UpdateSourceTrigger=PropertyChanged}"/>
            <ToggleButton x:Name="SheetHelp" Style="{StaticResource InlineLink}" Content="Как определить?"/>
            <controls:CollapsibleBody Style="{StaticResource CollapsibleBody}" IsOpen="{Binding IsChecked, ElementName=SheetHelp}">
                <StackPanel Margin="0,4,0,4">
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Открой нужную вкладку таблицы, скопируй адрес из адресной строки (в нём есть «gid=…») и вставь сюда."/>
                    <TextBox Style="{StaticResource Field}" Text="{Binding SheetLinkText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Определить номер листа" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                            Command="{Binding DetectSheetCommand}"/>
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="{Binding SheetNote}" Margin="0,6,0,0"/>
                </StackPanel>
            </controls:CollapsibleBody>

            <TextBlock Text="Токен Singularity" Style="{StaticResource FieldTitle}"/>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="Ключ, по которому сервис входит в твой аккаунт. Он уже лежит в файле настроек, а на экране закрыт точками. Если выпустишь новый, вставь его вместо текущего и сохрани."/>
            <PasswordBox Style="{StaticResource SecretField}"
                         behaviors:PasswordBinding.Password="{Binding Token, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <ToggleButton x:Name="TokenHelp" Style="{StaticResource InlineLink}" Content="Где выпустить токен?"/>
            <controls:CollapsibleBody Style="{StaticResource CollapsibleBody}" IsOpen="{Binding IsChecked, ElementName=TokenHelp}">
                <StackPanel Margin="0,4,0,4">
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Открой страницу токенов Singularity, создай токен с доступом к проектам и задачам на чтение и запись и вставь его в поле выше."/>
                    <Button Content="Открыть страницу токенов" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                            Command="{Binding OpenTokenPageCommand}"/>
                </StackPanel>
            </controls:CollapsibleBody>
            <StackPanel Orientation="Horizontal" Margin="0,24,0,8">
                <Button Content="Сохранить и перезапустить" Style="{StaticResource PrimaryButton}" Command="{Binding SaveAndRestartCommand}"/>
                <Button Content="Перезапустить" Style="{StaticResource ActionButton}" Command="{Binding RestartCommand}" Margin="8,0,0,0"/>
            </StackPanel>
            </StackPanel>
            </controls:CollapsibleBody>
    </StackPanel>
</UserControl>
