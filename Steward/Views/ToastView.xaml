<UserControl x:Class="Steward.Views.ToastView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
    <!-- Окошко живёт поверх страницы внизу: текст, «Откатить» (если есть что откатывать) и «Закрыть» -->
    <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="16,8,8,8" MaxWidth="560"
            AutomationProperties.LiveSetting="Polite">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
            <Button Command="{Binding UndoCommand}" Style="{StaticResource IconButton}" Margin="16,0,0,0"
                    Visibility="{Binding HasUndo, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="Откатить" AutomationProperties.Name="Откатить">
                <Path Data="{StaticResource IconUndo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18"/>
            </Button>
            <Button Command="{Binding CloseCommand}" Style="{StaticResource IconButton}" ToolTip="Закрыть" AutomationProperties.Name="Закрыть">
                <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18"/>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
