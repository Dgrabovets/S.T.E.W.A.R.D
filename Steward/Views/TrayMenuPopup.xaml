<Window x:Class="Steward.Views.TrayMenuPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Steward.Controls"
        Title="Steward"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Background="{StaticResource WindowBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource FontBase}">
    <Border Style="{StaticResource WindowChrome}" CornerRadius="{StaticResource RadiusSystemWindow}" Padding="8" MinWidth="230">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="8,6,8,10">
                <ctl:ActivityOrb Width="26" Height="26" Kind="Alive" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="S.T.E.W.A.R.D" Style="{StaticResource TextTitle}" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Height="1" Background="{StaticResource LineBrush}" Margin="4,0,4,6"/>
            <RadioButton x:Name="OpenItem" Style="{StaticResource NavButton}" Content="Открыть Steward" GroupName="TrayMenu" Click="Open_OnClick"/>
            <RadioButton x:Name="ExitItem" Style="{StaticResource NavButton}" Content="Выход" GroupName="TrayMenu" Click="Exit_OnClick"/>
        </StackPanel>
    </Border>
</Window>
