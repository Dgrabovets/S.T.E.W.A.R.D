<UserControl x:Class="Steward.Views.HomeworkFormatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Steward.Controls"
             xmlns:hw="clr-namespace:Steward.Homework.Models;assembly=Steward.Homework">
    <UserControl.Resources>
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource WindowBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusField}" Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{StaticResource RaisedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="ReaderViewer" TargetType="FlowDocumentScrollViewer">
            <Setter Property="IsToolBarVisible" Value="False"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource TextSecondary}" TextWrapping="Wrap"
                       Text="Занятий пока нет. Они появятся после первой выгрузки из LMS."/>
        </Border>

        <!-- Плитки предметов -->
        <ItemsControl ItemsSource="{Binding Subjects}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Tile" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,10,10" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource TextTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                <Ellipse x:Name="Orb" Grid.Column="1" Width="12" Height="12" Fill="{StaticResource AttentionBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="{Binding TranscribedText}" Style="{StaticResource TextCaption}" Margin="0,10,0,0"/>
                            <ProgressBar x:Name="Bar" Value="{Binding Progress, Mode=OneWay}" Style="{StaticResource ThinProgress}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding AssignmentsText}" Style="{StaticResource TextCaption}" Margin="0,8,0,0"/>
                            <ProgressBar Value="{Binding AssignmentsProgress, Mode=OneWay}" Style="{StaticResource ThinProgress}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding QuizzesText}" Style="{StaticResource TextCaption}" Margin="0,8,0,0"/>
                            <ProgressBar Value="{Binding QuizzesProgress, Mode=OneWay}" Style="{StaticResource ThinProgress}" Margin="0,4,0,0"/>
                        </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,12,0,0">
                                <ComboBox Style="{StaticResource FieldChoice}" Width="172" Margin="0,0,8,0"
                                          ItemsSource="{Binding StateOptions}" SelectedItem="{Binding SelectedStateOption, Mode=TwoWay}"
                                          Visibility="{Binding HasStates, Converter={StaticResource BoolToVisibility}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox Style="{StaticResource FieldChoice}" Width="172" Margin="0"
                                          ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding SelectedFormatOption, Mode=TwoWay}"
                                          Visibility="{Binding ShowFormat, Converter={StaticResource BoolToVisibility}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentTextBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static hw:LessonStateEnum.Fetch}">
                            <Setter TargetName="Orb" Property="Fill" Value="{StaticResource OkBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static hw:LessonStateEnum.Skip}">
                            <Setter TargetName="Orb" Property="Fill" Value="{StaticResource IdleBrush}"/>
                            <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource IdleBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static hw:LessonStateEnum.Done}">
                            <Setter TargetName="Orb" Property="Fill" Value="{StaticResource AccentTextBrush}"/>
                            <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Вкладки выбранного предмета -->
        <StackPanel Margin="0,0,10,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedSubject}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Расшифровки" Command="{Binding ShowTranscriptsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTranscriptsTab}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Домашние задания" Command="{Binding ShowHomeworkCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHomeworkTab}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Расшифровки -->
            <StackPanel Visibility="{Binding IsTranscriptsTab, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ItemsControl ItemsSource="{Binding SelectedSubject.Lessons}" Margin="0,0,12,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Headline}" Style="{StaticResource TextBody}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Headline}"/>
                                                <TextBlock Text="{Binding Duration}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" Visibility="{Binding HasDuration, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Command="{Binding OpenCommand}" Style="{StaticResource OutlineButton}" Padding="7" Margin="8,0,0,0" ToolTip="Посмотреть расшифровку"
                                                    Visibility="{Binding HasTranscript, Converter={StaticResource BoolToVisibility}}">
                                                <Canvas Width="18" Height="18">
                                                    <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M1.5,9 C4,4.5 6.5,3 9,3 C11.5,3 14,4.5 16.5,9 C14,13.5 11.5,15 9,15 C6.5,15 4,13.5 1.5,9 Z"/>
                                                    <Ellipse Canvas.Left="6.5" Canvas.Top="6.5" Width="5" Height="5" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5"/>
                                                </Canvas>
                                            </Button>
                                            <Button Grid.Column="1" Content="Расшифровать" Command="{Binding FetchCommand}" Style="{StaticResource ActionButton}" Margin="8,0,0,0"
                                                    Visibility="{Binding CanFetch, Converter={StaticResource BoolToVisibility}}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                        <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentTextBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AllSubmitted}" Value="True">
                                        <Setter TargetName="Row" Property="Opacity" Value="0.6"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,8" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="Выбери занятие и нажми «Посмотреть расшифровку»: здесь появятся резюме встречи и полный текст.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextSecondary}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasOpenLesson}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Grid Visibility="{Binding HasOpenLesson, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="✕" Command="{Binding CloseLessonCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Закрыть"/>
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding ReadingStats}" Margin="0,0,40,0" AlternationCount="100">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Cell" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1,0,0,0" Padding="14,0,6,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource TextCaption}"/>
                                                    <TextBlock Text="{Binding Value}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeBodyLarge}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                                    <Setter TargetName="Cell" Property="BorderThickness" Value="0"/>
                                                    <Setter TargetName="Cell" Property="Padding" Value="0,0,6,0"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ReadingTopic}" Foreground="{StaticResource AccentTextBrush}" FontSize="{StaticResource FontSizeBodyLarge}" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="{Binding HasReadingTopic, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Content="Скопировать конспект к практике" Command="{Binding CopyBriefCommand}" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        ToolTip="Темы, формулировки и задачи занятия одним текстом: повторить перед практикой"
                                        Visibility="{Binding HasReadingTopics, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="Подробный разбор ещё готовится: он появится после ближайшей выгрузки. Пока показано короткое резюме." Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding ReadingBrief, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="В файле расшифровки нет резюме: заново запроси расшифровку занятия." Style="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="{Binding ReadingEmpty, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="Пройдено" Style="{StaticResource TextCaption}" Margin="0,14,0,6"
                                           Visibility="{Binding HasReadingPoints, Converter={StaticResource BoolToVisibility}}"/>
                                <ItemsControl ItemsSource="{Binding ReadingPoints}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="•" Foreground="{StaticResource AccentTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" LineHeight="22"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,12,0,0"
                                        Visibility="{Binding HasReadingOverview, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Что было на занятии" Style="{StaticResource TextCaption}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding ReadingOverview}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" LineHeight="22"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Темы" Style="{StaticResource TextCaption}" Margin="0,14,0,6" Visibility="{Binding HasReadingTopics, Converter={StaticResource BoolToVisibility}}"/>
                                <ItemsControl ItemsSource="{Binding ReadingTopics}" Visibility="{Binding HasReadingTopics, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="22" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Формулировки" Style="{StaticResource TextCaption}" Margin="0,14,0,6" Visibility="{Binding HasReadingFormulations, Converter={StaticResource BoolToVisibility}}"/>
                                <ItemsControl ItemsSource="{Binding ReadingFormulations}" Visibility="{Binding HasReadingFormulations, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource AccentOutlineBrush}" BorderThickness="2,0,0,0" Padding="10,2,0,2" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" LineHeight="22" FontStyle="Italic"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Принятые решения" Style="{StaticResource TextCaption}" Margin="0,14,0,6" Visibility="{Binding HasReadingDecisions, Converter={StaticResource BoolToVisibility}}"/>
                                <ItemsControl ItemsSource="{Binding ReadingDecisions}" Visibility="{Binding HasReadingDecisions, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="•" Foreground="{StaticResource AccentTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" LineHeight="22"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Задачи с занятия" Style="{StaticResource TextCaption}" Margin="0,14,0,6" Visibility="{Binding HasReadingTasks, Converter={StaticResource BoolToVisibility}}"/>
                                <ItemsControl ItemsSource="{Binding ReadingTasks}" Visibility="{Binding HasReadingTasks, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="•" Foreground="{StaticResource AccentTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" LineHeight="22"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Кто говорил" Style="{StaticResource TextCaption}" Margin="0,14,0,6" Visibility="{Binding HasReadingSpeakers, Converter={StaticResource BoolToVisibility}}"/>
                                <ItemsControl ItemsSource="{Binding ReadingSpeakers}" Visibility="{Binding HasReadingSpeakers, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <Grid>
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeBody}" TextTrimming="CharacterEllipsis" Margin="0,0,48,0"/>
                                                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBody}">
                                                        <Run Text="{Binding Value, Mode=OneWay}"/><Run Text="%"/>
                                                    </TextBlock>
                                                </Grid>
                                                <ProgressBar Value="{Binding Share, Mode=OneWay}" Style="{StaticResource ThinProgress}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Домашние задания -->
            <StackPanel Visibility="{Binding IsHomeworkTab, Converter={StaticResource BoolToVisibility}}">
                <TextBlock TextWrapping="Wrap" Margin="4,0,0,8"
                           Text="Для этого предмета домашние задания не готовятся. Выбери «Расшифровывать» в списке на плитке, и здесь появятся задания и готовые работы.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextSecondary}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSubject.ShowFormat}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border Style="{StaticResource Card}" Padding="14,8" Margin="0,0,0,8" Visibility="{Binding SelectedSubject.ShowFormat, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusBadge}" Padding="10,2" Margin="0,0,8,0">
                                <TextBlock Text="{Binding GuideCountText}" Style="{StaticResource TextCaption}" Foreground="{StaticResource TextBrush}"/>
                            </Border>
                            <Border BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusBadge}" Padding="10,2">
                                <TextBlock Text="{Binding ExampleCountText}" Style="{StaticResource TextCaption}" Foreground="{StaticResource TextBrush}"/>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Методические указания" Command="{Binding ManageGuidesCommand}" Style="{StaticResource OutlineButton}" BorderBrush="{StaticResource AccentOutlineBrush}" Foreground="{StaticResource AccentTextBrush}"/>
                    </Grid>
                </Border>
                <StackPanel Margin="0,8,0,0" Visibility="{Binding SelectedSubject.ShowFormat, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding SelectedSubject.LessonsWithTranscript}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="14,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Headline}" Style="{StaticResource TextBody}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Headline}"/>
                                            <TextBlock Text="{Binding Duration}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" Visibility="{Binding HasDuration, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button Content="Подготовить задание" Command="{Binding PrepareCommand}" Style="{StaticResource PrimaryButton}"
                                                    Visibility="{Binding CanPrepare, Converter={StaticResource BoolToVisibility}}"/>
                                            <ItemsControl ItemsSource="{Binding Drafts}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding ButtonTitle}" Command="{Binding OpenCommand}" Style="{StaticResource OutlineButton}" Margin="0,2,0,2" ToolTip="{Binding Name}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0"
                                                        Visibility="{Binding HasDrafts, Converter={StaticResource BoolToVisibility}}">
                                                <Button Content="Проверить" Command="{Binding CheckCommand}" Style="{StaticResource GhostButton}" ToolTip="Сверить работу с условием и методичкой и найти факты без опоры. Работа не меняется"/>
                                                <Button Content="Результат проверки" Command="{Binding OpenCheckCommand}" Style="{StaticResource GhostButton}" ToolTip="Открыть отчёт о проверке"
                                                        Visibility="{Binding HasCheck, Converter={StaticResource BoolToVisibility}}"/>
                                                <Button Command="{Binding RedoCommand}" Style="{StaticResource IconButton}" ToolTip="Переделать: написать, что не понравилось">
                                                    <Path Data="{StaticResource IconRedo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18"/>
                                                </Button>
                                                <Button Command="{Binding DeleteCommand}" Style="{StaticResource IconButton}" ToolTip="Удалить готовое задание">
                                                    <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                            <TextBlock Text="{Binding ItemsHint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                                       Visibility="{Binding HasItemsHint, Converter={StaticResource BoolToVisibility}}"/>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,4">
                                                            <StackPanel>
                                                                <StackPanel>
                                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Meta}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Requirements}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                                           Visibility="{Binding HasRequirements, Converter={StaticResource BoolToVisibility}}"/>
                                                            </StackPanel>
                                                                <WrapPanel Margin="0,4,0,0">
                                                                    <Button Content="В архив" Command="{Binding ArchiveCommand}" Style="{StaticResource GhostButton}" Margin="0,0,4,0" ToolTip="Убрать задание из списка: оно не будет готовиться"/>
                                                                    <Button Content="В Singularity" Command="{Binding AddToSingularityCommand}" Style="{StaticResource GhostButton}" Margin="0,0,4,0" ToolTip="Завести задачу по заданию в Singularity"/>
                                                                    <Button Content="Открыть в LMS" Command="{Binding OpenInLmsCommand}" Style="{StaticResource GhostButton}" Margin="0,0,4,0" ToolTip="Открыть страницу задания в LMS"/>
                                                                    <Button Content="{Binding SubmitLabel}" Command="{Binding ToggleSubmittedCommand}" Style="{StaticResource GhostButton}" Margin="0,0,4,0" ToolTip="Сданное задание не готовится. Отметку можно снять"
                                                                            Visibility="{Binding CanToggleSubmitted, Converter={StaticResource BoolToVisibility}}"/>
                                                                    <Button Content="Скопировать условие" Command="{Binding CopyConditionCommand}" Style="{StaticResource GhostButton}" Margin="0,0,4,0" ToolTip="Положить условие задания в буфер обмена"/>
                                                                
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"
                                                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                                            <ctl:ActivityOrb Width="28" Height="28" Style="{StaticResource ActivityOrb}" Margin="-6,-4,8,-4"/>
                                            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextSecondary}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Failed}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
