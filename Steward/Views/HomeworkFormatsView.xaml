<UserControl x:Class="Steward.Views.HomeworkFormatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Steward.Controls"
             xmlns:hw="clr-namespace:Steward.Homework.Models;assembly=Steward.Homework">
    <StackPanel>
        <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource TextSecondary}" TextWrapping="Wrap"
                       Text="Занятий пока нет. Они появятся после первой выгрузки из LMS."/>
        </Border>

        <!-- Плитки предметов -->
        <ItemsControl ItemsSource="{Binding Subjects}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding SelectCommand}" Margin="0,0,10,10" Cursor="Hand" Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Button.Template>
                        <Border x:Name="Tile" Style="{StaticResource Card}" Padding="14,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                    <Ellipse x:Name="Orb" Grid.Column="1" Width="12" Height="12" Fill="{StaticResource AttentionBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Transcribed}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeHeadline}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource TextCaption}" VerticalAlignment="Bottom" Margin="8,0,0,5"/>
                                </StackPanel>
                                <ProgressBar x:Name="Bar" Value="{Binding Progress, Mode=OneWay}" Style="{StaticResource ThinProgress}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding Caption}" Style="{StaticResource TextCaption}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentTextBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static hw:LessonStateEnum.Fetch}">
                            <Setter TargetName="Orb" Property="Fill" Value="{StaticResource OkBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static hw:LessonStateEnum.Skip}">
                            <Setter TargetName="Orb" Property="Fill" Value="{StaticResource IdleBrush}"/>
                            <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource IdleBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static hw:LessonStateEnum.Done}">
                            <Setter TargetName="Orb" Property="Fill" Value="{StaticResource AccentTextBrush}"/>
                            <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Панель выбранного предмета -->
        <ContentControl Content="{Binding SelectedSubject}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" BorderBrush="{StaticResource AccentOutlineBrush}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource TextTitle}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource TextSecondary}" Margin="0,2,0,0"/>

                            <TextBlock Text="Что делать с занятиями" Style="{StaticResource TextCaption}" Margin="0,14,0,6" Visibility="{Binding HasStates, Converter={StaticResource BoolToVisibility}}"/>
                            <ItemsControl ItemsSource="{Binding StateOptions}" Visibility="{Binding HasStates, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Title}" Command="{Binding SelectCommand}" Margin="0,0,8,6" BorderThickness="1">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentOutlineBrush}"/>
                                                            <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Формат заданий по умолчанию" Style="{StaticResource TextCaption}" Margin="0,8,0,6" Visibility="{Binding HasFormats, Converter={StaticResource BoolToVisibility}}"/>
                            <ItemsControl ItemsSource="{Binding FormatOptions}" Visibility="{Binding HasFormats, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Title}" Command="{Binding SelectCommand}" Margin="0,0,8,6" BorderThickness="1">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentOutlineBrush}"/>
                                                            <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Занятия" Style="{StaticResource TextCaption}" Margin="0,8,0,6"/>
                            <ItemsControl ItemsSource="{Binding Lessons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Background="Transparent" Margin="0,0,0,8" Padding="14,10">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource TextBody}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                                                        <Button Content="Расшифровать" Command="{Binding FetchCommand}" Style="{StaticResource ActionButton}"
                                                                Visibility="{Binding CanFetch, Converter={StaticResource BoolToVisibility}}"/>
                                                        <Grid Visibility="{Binding HasTranscript, Converter={StaticResource BoolToVisibility}}">
                                                            <Button x:Name="PrepareButton" Content="Подготовить задания  ▾" Command="{Binding PrepareCommand}" Style="{StaticResource PrimaryButton}"/>
                                                            <Popup IsOpen="{Binding IsMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=PrepareButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="4">
                                                                <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceBrush}" Padding="8" MinWidth="200">
                                                                    <StackPanel>
                                                                        <TextBlock Text="В каком формате готовить" Style="{StaticResource TextCaption}" Margin="8,4,8,6"/>
                                                                        <ItemsControl ItemsSource="{Binding Options}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Button Command="{Binding SelectCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,2">
                                                                                        <Button.Style>
                                                                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                                        <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
                                                                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Button.Style>
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <TextBlock Text="{Binding Title}"/>
                                                                                            <TextBlock Text="  по умолчанию" Style="{StaticResource TextCaption}" VerticalAlignment="Center"
                                                                                                       Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"/>
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Popup>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                                                    <ctl:ActivityOrb Width="28" Height="28" Style="{StaticResource ActivityOrb}" Margin="-6,-4,8,-4"/>
                                                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextSecondary}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Failed}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </StackPanel>
</UserControl>
