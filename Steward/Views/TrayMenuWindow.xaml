<views:TrayPopupWindow x:Class="Steward.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Steward.Views"
        xmlns:ctl="clr-namespace:Steward.Controls"
        xmlns:ui="clr-namespace:Steward.Models"
        Title="S.T.E.W.A.R.D"
        Width="500"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource FontBase}">
    <Window.Resources>
        <Style x:Key="Cluster" TargetType="ctl:GooeyCluster">
            <Setter Property="Fill" Value="{StaticResource RaisedBrush}"/>
            <Setter Property="Outline" Value="{StaticResource LineStrongBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="StateBrush" Value="{StaticResource IdleBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelToneEnum.Running}">
                    <Setter Property="StateBrush" Value="{StaticResource OkBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelToneEnum.Attention}">
                    <Setter Property="StateBrush" Value="{StaticResource AttentionBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelToneEnum.Problem}">
                    <Setter Property="StateBrush" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource WindowChrome}">
        <StackPanel Margin="20,18,20,10">
            <Grid Margin="0,0,0,12">
                <TextBlock Text="Быстрый статус" Style="{StaticResource TextTitle}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ctl:ActivityOrb Width="26" Height="26" Style="{StaticResource SummaryOrb}" Margin="0,-2,6,-2"/>
                    <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusField}" Padding="14,10">
                <ItemsControl ItemsSource="{Binding Tasks}" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Status"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource TextBody}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ctl:ActivityOrb Width="22" Height="22" Style="{StaticResource ActivityOrb}" Margin="12,0,6,0"/>
                                    <TextBlock Text="{Binding Headline}" Style="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,10,0,0"/>

            <ctl:GooeyCluster x:Name="Cluster" Style="{StaticResource Cluster}"/>
        </StackPanel>
    </Border>
</views:TrayPopupWindow>