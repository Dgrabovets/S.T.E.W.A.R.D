<views:TrayPopupWindow x:Class="Steward.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Steward.Views"
        xmlns:ctl="clr-namespace:Steward.Controls"
        xmlns:ui="clr-namespace:Steward.Models"
        Title="Steward"
        Width="500"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource FontBase}">
    <Window.Resources>
        <Style x:Key="Cluster" TargetType="ctl:GooeyCluster">
            <Setter Property="Fill" Value="{StaticResource RaisedBrush}"/>
            <Setter Property="Outline" Value="{StaticResource LineStrongBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="StateBrush" Value="{StaticResource IdleBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelToneEnum.Running}">
                    <Setter Property="StateBrush" Value="{StaticResource OkBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelToneEnum.Attention}">
                    <Setter Property="StateBrush" Value="{StaticResource AttentionBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelToneEnum.Problem}">
                    <Setter Property="StateBrush" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource WindowChrome}">
        <StackPanel Margin="20,18,20,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Быстрый статус" Style="{StaticResource TextTitle}"/>
                <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource TextSecondary}" Margin="12,3,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource TextCaption}" Margin="0,4,0,10"/>

            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusField}" Padding="14,10">
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ctl:ActivityOrb Width="28" Height="28" Style="{StaticResource ActivityOrb}" Margin="-6,-4,6,-4"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource TextBody}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Headline}" Style="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14,0,6"/>

            <ctl:GooeyCluster x:Name="Cluster" Style="{StaticResource Cluster}"/>
        </StackPanel>
    </Border>
</views:TrayPopupWindow>