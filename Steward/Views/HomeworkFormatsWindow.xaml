<Window x:Class="Steward.Views.HomeworkFormatsWindow"
        Icon="pack://application:,,,/Assets/steward.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Steward.Controls"
        xmlns:views="clr-namespace:Steward.Views"
        Title="Форматы ДЗ"
        Width="760"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource FontBase}">
    <Grid Margin="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Форматы домашних заданий" Style="{StaticResource TextHeadline}"/>
                <TextBlock Style="{StaticResource TextSecondary}" Margin="0,4,0,16" TextWrapping="Wrap"
                           Text="Выбери, в каком виде готовить ДЗ по каждому занятию. По умолчанию — Word. Выбор сохраняется сразу."/>
                <views:HomeworkFormatsView/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>