<Window x:Class="Steward.Views.HomeworkFormatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Steward.Controls"
        Title="Форматы ДЗ"
        Width="760"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource FontBase}">
    <Grid Margin="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Форматы домашних заданий" Style="{StaticResource TextHeadline}"/>
                <TextBlock Style="{StaticResource TextSecondary}" Margin="0,4,0,16" TextWrapping="Wrap"
                           Text="Выбери, в каком виде готовить ДЗ по каждому занятию. По умолчанию — Word. Выбор сохраняется сразу."/>
                <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource TextSecondary}" TextWrapping="Wrap"
                               Text="Занятий пока нет. Они появятся после выгрузки расшифровок из MTS Link."/>
                </Border>
                <ItemsControl ItemsSource="{Binding Lessons}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource TextTitle}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Date}" Style="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Подготовить задания" Command="{Binding PrepareCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" Margin="16,0,0,0"
                                                Visibility="{Binding HasTranscript, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                                        <ctl:ActivityOrb Width="28" Height="28" Style="{StaticResource ActivityOrb}" Margin="-6,-4,8,-4"/>
                                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextSecondary}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Failed}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="Формат" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <ItemsControl ItemsSource="{Binding Options}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Title}" Command="{Binding SelectCommand}" Margin="0,0,8,0" BorderThickness="1">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentOutlineBrush}"/>
                                                                        <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>