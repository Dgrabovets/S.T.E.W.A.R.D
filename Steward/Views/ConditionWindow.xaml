<Window x:Class="Steward.Views.ConditionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="S.T.E.W.A.R.D"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource FontBase}"
        Width="520"
        SizeToContent="Height"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Border Style="{StaticResource WindowChrome}">
        <StackPanel Margin="24,18,24,20">
            <Grid Background="Transparent" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Поправить условие" Style="{StaticResource TextHeadline}"/>
                    <TextBlock x:Name="Heading" Style="{StaticResource TextCaption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Click="Cancel_OnClick" Style="{StaticResource IconButton}" VerticalAlignment="Top" ToolTip="Закрыть" AutomationProperties.Name="Закрыть">
                    <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18"/>
                </Button>
            </Grid>

            <TextBlock Text="Что нужно сделать" Style="{StaticResource TextCaption}" Margin="0,16,0,6"/>
            <TextBox x:Name="TitleBox" Style="{StaticResource Field}" Margin="0" AutomationProperties.Name="Что нужно сделать"/>
            <TextBlock x:Name="TitleError" Style="{StaticResource HintError}" Margin="0,4,0,0" Visibility="Collapsed"
                       Text="Напиши, что нужно сделать: без формулировки правку не сохранить"/>
            <TextBlock Text="Требования" Style="{StaticResource TextCaption}" Margin="0,12,0,6"/>
            <TextBox x:Name="RequirementsBox" Style="{StaticResource Field}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="220"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0" AutomationProperties.Name="Требования"/>
            <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Задание станет подтверждённым и подготовится при ближайшей выгрузке. Правка запомнится замечанием для этого предмета."/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Отмена" Click="Cancel_OnClick" IsCancel="True" Style="{StaticResource GhostButton}"/>
                <Button Content="Сохранить" Click="Confirm_OnClick" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
