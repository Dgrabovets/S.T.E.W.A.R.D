<Window x:Class="Steward.Views.PrepareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="S.T.E.W.A.R.D"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource FontBase}"
        Width="620"
        SizeToContent="Height"
        MaxHeight="760"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Window.Resources>
        <DataTemplate x:Key="ChoiceRow">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,0,0,6" ToolTip="{Binding Meta}">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}"/>
            </CheckBox>
        </DataTemplate>
    </Window.Resources>
    <Border Style="{StaticResource WindowChrome}">
        <StackPanel Margin="24,18,24,20">
            <Grid x:Name="Header" Background="Transparent" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Подготовить задание" Style="{StaticResource TextHeadline}"/>
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource TextCaption}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Click="Cancel_OnClick" Style="{StaticResource IconButton}" VerticalAlignment="Top" ToolTip="Закрыть">
                    <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18"/>
                </Button>
            </Grid>

            <TextBlock Text="Формат работы" Style="{StaticResource TextCaption}" Margin="0,16,0,6"/>
            <ItemsControl ItemsSource="{Binding Formats}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Title}" Command="{Binding SelectCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ChoiceButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentOutlineBrush}"/>
                                            <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Ещё одно указание" Style="{StaticResource TextCaption}" Margin="0,10,0,6"/>
            <TextBox Text="{Binding Extra, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="120"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0"
                     ToolTip="Например: сделай упор на сравнение двух игр или уложись в одну страницу"/>

            <TextBlock Text="Что учесть" Style="{StaticResource TextCaption}" Margin="0,16,0,6"/>
            <TextBlock Text="Для этого предмета методических указаний и образцов нет. Их можно добавить кнопкой «Методические указания»." Style="{StaticResource TextSecondary}" TextWrapping="Wrap"
                       Visibility="{Binding NoMaterials, Converter={StaticResource BoolToVisibility}}"/>
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Visibility="{Binding HasGuides, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Методические указания" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBody}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding Guides}" ItemTemplate="{StaticResource ChoiceRow}"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding HasExamples, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                        <TextBlock Text="Образцы" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBody}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding Examples}" ItemTemplate="{StaticResource ChoiceRow}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Отмена" Click="Cancel_OnClick" IsCancel="True" Style="{StaticResource GhostButton}"/>
                <Button Content="Подготовить" Click="Confirm_OnClick" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
