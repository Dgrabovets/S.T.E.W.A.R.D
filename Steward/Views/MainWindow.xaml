<Window x:Class="Steward.Views.MainWindow"
        Icon="pack://application:,,,/Assets/steward.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Steward.Models"
        xmlns:ctl="clr-namespace:Steward.Controls"
        xmlns:views="clr-namespace:Steward.Views"
        Title="Задачи"
        Width="1080"
        Height="860"
        MinWidth="900"
        MinHeight="680"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource WindowBrush}"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource FontBase}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TextHeadline}">
            <Setter Property="Margin" Value="4,0,0,4"/>
        </Style>

        <Style x:Key="PageHint" TargetType="TextBlock" BasedOn="{StaticResource TextSecondary}">
            <Setter Property="LineHeight" Value="22"/>
        </Style>

        <Style x:Key="PageHost" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource WindowChrome}" CornerRadius="{StaticResource RadiusSystemWindow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Margin="24,16,16,8" Background="Transparent" MouseLeftButtonDown="TitleBar_OnDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="52" Height="52" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Ellipse Width="88" Height="88" Opacity="0.35" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="{StaticResource AccentColor}" Offset="0.3"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelToneEnum.Running}">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="GlowPulse">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:1.4"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="GlowPulse"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Image Source="pack://application:,,,/Assets/steward.ico" Margin="3" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <TextBlock Text="S.T.E.W.A.R.D" Style="{StaticResource TextDisplay}" VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource TextColor}" Offset="0.25"/>
                                <GradientStop Color="{StaticResource AccentTextColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource ToneBadge}" Padding="10,4,16,4" VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <ctl:ActivityOrb Width="24" Height="24" Style="{StaticResource SummaryOrb}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource ToneBadgeText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button Grid.Column="2" Content="—" Style="{StaticResource GhostButton}" Click="Minimize_OnClick" ToolTip="Свернуть"/>
                <Button Grid.Column="3" Content="✕" Style="{StaticResource GhostButton}" Click="Close_OnClick" ToolTip="Скрыть в трей"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Margin="16,8,8,16">
                    <StackPanel>
                        <RadioButton GroupName="Nav" Content="Статус" Style="{StaticResource NavButton}" IsChecked="{Binding IsStatusPage, Mode=TwoWay}"/>
                        <RadioButton GroupName="Nav" Content="Идеи" Style="{StaticResource NavButton}" IsChecked="{Binding IsIdeasPage, Mode=TwoWay}"/>
                        <RadioButton GroupName="Nav" Content="Домашние задания" Style="{StaticResource NavButton}" IsChecked="{Binding IsHomeworkPage, Mode=TwoWay}"/>
                        <RadioButton GroupName="Nav" Content="Журнал" Style="{StaticResource NavButton}" IsChecked="{Binding IsJournalPage, Mode=TwoWay}"/>
                    </StackPanel>
                    <Button Content="Выход" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Command="{Binding ExitCommand}"/>
                </Grid>

                <Grid Grid.Column="1" Margin="8,4,24,24">
                    <!-- Статус -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid" BasedOn="{StaticResource PageHost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusPage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Задачи" Style="{StaticResource PageTitle}"/>
                                <Border Style="{StaticResource Card}" Background="{StaticResource AttentionSurfaceBrush}"
                                        Visibility="{Binding HasRegistryErrors, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="В config/jobs.json есть ошибки" Foreground="{StaticResource AttentionBrush}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"/>
                                        <TextBlock Text="{Binding RegistryErrors}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Card" Style="{StaticResource Card}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ctl:ActivityOrb Width="24" Height="24" Style="{StaticResource ActivityOrb}" VerticalAlignment="Top" Margin="-4,0,12,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="Name" Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Headline}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBodyLarge}" Margin="12,2,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="Reason" Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                    <Button x:Name="Run" Grid.Column="2" Content="Запустить" Style="{StaticResource ActionButton}" Margin="12,0,0,0"
                                                            VerticalAlignment="Top" Command="{Binding RunCommand}" Visibility="Collapsed"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding CanRun}" Value="True">
                                                    <Setter TargetName="Run" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Muted}" Value="True">
                                                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelToneEnum.Problem}">
                                                    <Setter TargetName="Card" Property="Background" Value="{StaticResource DangerSurfaceBrush}"/>
                                                    <Setter TargetName="Reason" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Идеи -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid" BasedOn="{StaticResource PageHost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsIdeasPage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Идеи" Style="{StaticResource PageTitle}"/>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding IsReelsBusy, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ctl:ActivityOrb Width="26" Height="26" Kind="Composing" Foreground="{StaticResource WorkingBrush}" Margin="-4,-2,12,-2"/>
                                        <TextBlock Text="Бот разбирает рилс. Идея появится здесь через пару минут" Style="{StaticResource PageHint}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Visibility="{Binding IsIdeasEmpty, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Идей пока нет" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource PageHint}" Margin="0,8,0,0"
                                                   Text="Пришли ссылку на рилс боту в Telegram: через несколько минут идея появится здесь с кнопками «Делаем» и «Отклонить». Если принять идею, откроется Claude Code с готовой просьбой, а ты отправишь её сам."/>
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Ideas}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource PageHint}" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding Preview}" Style="{StaticResource PageHint}" Margin="0,8,0,0" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                                                               Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                        <Button Content="Делаем" Command="{Binding ApproveCommand}" Style="{StaticResource PrimaryButton}"/>
                                                        <Button Content="Отклонить" Command="{Binding RejectCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                                                        <Button Content="Открыть рилс" Command="{Binding OpenSourceCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ДЗ -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid" BasedOn="{StaticResource PageHost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHomeworkPage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                            <TextBlock Text="Домашние задания" Style="{StaticResource PageTitle}"/>
                            <Border Style="{StaticResource Card}" Visibility="{Binding IsHomeworkEmpty, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Заданий пока нет" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource PageHint}" Margin="0,8,0,0"
                                               Text="Задания появятся здесь, когда по занятию с расшифровкой нажмёшь «Подготовить задания» в настройках, в блоке «Форматы заданий». Для каждого будет видно срок, формат и создана ли задача в SingularityApp."/>
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Homework}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Lesson}" Style="{StaticResource PageHint}" Margin="0,4,0,0"/>
                                                    <TextBlock Style="{StaticResource PageHint}" Margin="0,4,0,0">
                                                        <Run Text="{Binding Due, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Format, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Requirements}" Style="{StaticResource PageHint}" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                               Visibility="{Binding HasRequirements, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource ToneBadge}" Padding="8,4,12,4" VerticalAlignment="Top" Margin="16,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ctl:ActivityOrb Width="22" Height="22" Style="{StaticResource StatusOrb}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Status}" Style="{StaticResource ToneBadgeText}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Журнал -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid" BasedOn="{StaticResource PageHost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsJournalPage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,12,0">
                                <Grid Margin="0,0,0,20">
                                    <TextBlock Text="Журнал" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
                                    <Button Content="Очистить журнал" Style="{StaticResource ActionButton}" HorizontalAlignment="Right"
                                            Command="{Binding ClearJournalCommand}" Visibility="{Binding HasRecords, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                                <TextBlock Text="Записей пока нет" Style="{StaticResource PageHint}" Margin="4,0,0,0"
                                           Visibility="{Binding IsJournalEmpty, Converter={StaticResource BoolToVisibility}}"/>
                                <ItemsControl ItemsSource="{Binding Groups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="8,6,8,8" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <ToggleButton IsChecked="{Binding IsOpen, Mode=TwoWay}" Style="{StaticResource SectionToggle}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ctl:ActivityOrb Width="26" Height="26" Style="{StaticResource StatusOrb}" Margin="0,0,12,0"/>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" Style="{StaticResource TextTitle}"/>
                                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource TextCaption}" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <ctl:CollapsibleBody Style="{StaticResource CollapsibleBody}" IsOpen="{Binding IsOpen}">
                                                        <StackPanel Margin="4,0,4,0">
                                                            <ItemsControl ItemsSource="{Binding Runs}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Style="{StaticResource Card}" Background="Transparent" Padding="16,12" Margin="0,8,0,0">
                                                                            <StackPanel>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding When}" Style="{StaticResource TextBodyLarge}" FontWeight="SemiBold"/>
                                                                                        <Border x:Name="ReasonChip" Style="{StaticResource Chip}" Margin="12,0,0,0" VerticalAlignment="Center">
                                                                                            <TextBlock x:Name="ReasonText" Text="{Binding Reason}" Style="{StaticResource TextCaption}"/>
                                                                                        </Border>
                                                                                        <TextBlock Text="{Binding Facts}" Style="{StaticResource TextCaption}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                                                    </StackPanel>
                                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                                        <Border Style="{StaticResource ToneBadge}" Padding="12,3">
                                                                                            <TextBlock Text="{Binding Outcome}" Style="{StaticResource ToneBadgeText}"/>
                                                                                        </Border>
                                                                                        <Button Content="Починить с Claude" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                                                                                Command="{Binding FixCommand}" Visibility="{Binding CanFix, Converter={StaticResource BoolToVisibility}}"/>
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                                                           Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}"/>
                                                                                <Border Style="{StaticResource ReasonBlock}" Margin="0,10,0,0" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                                                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource TextBody}" TextWrapping="Wrap"/>
                                                                                </Border>
                                                                                <ItemsControl ItemsSource="{Binding OutputLines}" Margin="0,10,0,0"
                                                                                              Visibility="{Binding HasOutput, Converter={StaticResource BoolToVisibility}}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Border Style="{StaticResource LogLine}">
                                                                                                <Grid>
                                                                                                    <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                    </Grid.ColumnDefinitions>
                                                                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource TextMono}" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0"/>
                                                                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource TextMono}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                                                                                </Grid>
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <DataTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding IsManual}" Value="True">
                                                                                <Setter TargetName="ReasonChip" Property="BorderBrush" Value="{StaticResource AccentTextBrush}"/>
                                                                                <Setter TargetName="ReasonText" Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
                                                                            </DataTrigger>
                                                                        </DataTemplate.Triggers>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <ItemsControl ItemsSource="{Binding Checks}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Style="{StaticResource Card}" Background="Transparent" Padding="16,12" Margin="0,8,0,0">
                                                                            <StackPanel>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding When}" Style="{StaticResource TextBodyLarge}" FontWeight="SemiBold"/>
                                                                                        <TextBlock Text="{Binding Repeats}" Style="{StaticResource TextCaption}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                                                                   Visibility="{Binding HasRepeats, Converter={StaticResource BoolToVisibility}}"/>
                                                                                    </StackPanel>
                                                                                    <Border Grid.Column="1" Style="{StaticResource ToneBadge}" Padding="12,3">
                                                                                        <TextBlock Text="{Binding Outcome}" Style="{StaticResource ToneBadgeText}"/>
                                                                                    </Border>
                                                                                </Grid>
                                                                                <ItemsControl ItemsSource="{Binding Lines}" Margin="0,8,0,0" Visibility="{Binding HasQuietDetail, Converter={StaticResource BoolToVisibility}}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <TextBlock Text="{Binding}" Style="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                                <Border Style="{StaticResource ReasonBlock}" Margin="0,10,0,0" Visibility="{Binding HasBlock, Converter={StaticResource BoolToVisibility}}">
                                                                                    <ItemsControl ItemsSource="{Binding Lines}">
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate>
                                                                                                <TextBlock Text="{Binding}" Style="{StaticResource TextBody}" TextWrapping="Wrap" Margin="0,1"/>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                </Border>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Content="{Binding MoreLabel}" Style="{StaticResource ActionButton}" HorizontalAlignment="Center" Margin="0,12,0,4"
                                                                    Command="{Binding ShowMoreCommand}" Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}"/>
                                                        </StackPanel>
                                                    </ctl:CollapsibleBody>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
