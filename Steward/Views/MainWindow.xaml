<Window x:Class="Steward.Views.MainWindow"
        Icon="pack://application:,,,/Steward;component/Assets/steward.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Steward.Models"
        xmlns:ctl="clr-namespace:Steward.Controls"
        xmlns:views="clr-namespace:Steward.Views"
        xmlns:vm="clr-namespace:Steward.ViewModels"
        Title="Задачи"
        Width="1080"
        Height="860"
        MinWidth="900"
        MinHeight="680"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource WindowBrush}"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource FontBase}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TextHeadline}">
            <Setter Property="Margin" Value="4,0,0,4"/>
        </Style>

        <Style x:Key="PageHint" TargetType="TextBlock" BasedOn="{StaticResource TextSecondary}">
            <Setter Property="LineHeight" Value="22"/>
        </Style>

        <Style x:Key="GearButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
            <Setter Property="BorderBrush" Value="{StaticResource AccentTextBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
            <Setter Property="Padding" Value="7"/>
        </Style>

        <DataTemplate x:Key="TaskCardTemplate">
                    <Border x:Name="Card" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ctl:ActivityOrb Width="24" Height="24" Style="{StaticResource ActivityOrb}" VerticalAlignment="Top" Margin="-4,0,12,0"/>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Name" Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Headline}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBodyLarge}" Margin="12,2,0,0"/>
                                </StackPanel>
                                <ItemsControl x:Name="Reason" ItemsSource="{Binding DetailLines}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBody}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="•"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Button x:Name="Run" Grid.Column="2" Content="Запустить" Style="{StaticResource ActionButton}" Margin="12,0,0,0"
                                    VerticalAlignment="Top" Command="{Binding RunCommand}" Visibility="Collapsed"/>
                            <Button Grid.Column="3" Style="{StaticResource GearButton}" Margin="8,0,0,0" VerticalAlignment="Top" ToolTip="Настройки"
                                    Command="{Binding SettingsCommand}" Visibility="{Binding HasSettings, Converter={StaticResource BoolToVisibility}}">
                                <Canvas Width="16" Height="16">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,4 H14 M2,12 H14"/>
                                    <Ellipse Canvas.Left="8.5" Canvas.Top="1.5" Width="5" Height="5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="{StaticResource SurfaceBrush}"/>
                                    <Ellipse Canvas.Left="2.5" Canvas.Top="9.5" Width="5" Height="5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="{StaticResource SurfaceBrush}"/>
                                </Canvas>
                            </Button>
                            <Border Grid.Row="1" Grid.ColumnSpan="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0"
                                    Visibility="{Binding HasMetrics, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding Metrics}" AlternationCount="100">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Cell" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1,0,0,0" Padding="16,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource TextCaption}"/>
                                                    <TextBlock Text="{Binding Value}" Style="{StaticResource ToneBadgeText}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                                    <Setter TargetName="Cell" Property="BorderThickness" Value="0"/>
                                                    <Setter TargetName="Cell" Property="Padding" Value="0,0,8,0"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding CanRun}" Value="True">
                            <Setter TargetName="Run" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Muted}" Value="True">
                            <Setter TargetName="Name" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelToneEnum.Problem}">
                            <Setter TargetName="Card" Property="Background" Value="{StaticResource DangerSurfaceBrush}"/>
                            <Setter TargetName="Reason" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>

        <Style x:Key="CardHost" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource TaskCardTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Content" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TileTemplate">
            <Border Style="{StaticResource ToneBadge}" CornerRadius="{StaticResource RadiusCard}" Padding="14,10" Margin="0,0,8,8" MinWidth="170">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource TextCaption}" Visibility="{Binding HasLabel, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding Value}" Style="{StaticResource ToneBadgeText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="TilesRow" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource TileTemplate}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContentPanel" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsPanel" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PageHost" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource WindowChrome}" CornerRadius="{StaticResource RadiusSystemWindow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Margin="24,16,16,8" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ctl:ActivityOrb Width="52" Height="52" Kind="Alive" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock Text="S.T.E.W.A.R.D" Style="{StaticResource TextDisplay}" VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource TextColor}" Offset="0.25"/>
                                <GradientStop Color="{StaticResource AccentTextColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="2" Content="—" Style="{StaticResource GhostButton}" Click="Minimize_OnClick" ToolTip="Свернуть"/>
                <Button x:Name="MaximizeButton" Grid.Column="3" Content="☐" Style="{StaticResource GhostButton}" Click="Maximize_OnClick" ToolTip="Развернуть"/>
                <Button Grid.Column="4" Content="✕" Style="{StaticResource GhostButton}" Click="Close_OnClick" ToolTip="Скрыть в трей"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="312"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Margin="16,8,8,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding NavGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border BorderBrush="{StaticResource AccentTextBrush}" BorderThickness="2,0,0,0" Padding="8,0,0,0" Margin="10,14,0,6">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource TextCaption}"/>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <RadioButton GroupName="Nav" Style="{StaticResource NavButton}" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                        <views:NavTabContent/>
                                                    </RadioButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1">
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="8,8,8,8"/>
                        <ItemsControl ItemsSource="{Binding SystemItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="Nav" Style="{StaticResource NavButton}" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                        <views:NavTabContent/>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="1" Margin="8,4,24,24">
                    <!-- Статус -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid" BasedOn="{StaticResource PageHost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusPage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Задачи" Style="{StaticResource PageTitle}"/>
                                <Border Style="{StaticResource Card}" Background="{StaticResource AttentionSurfaceBrush}"
                                        Visibility="{Binding HasRegistryErrors, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="В config/jobs.json есть ошибки" Foreground="{StaticResource AttentionBrush}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"/>
                                        <TextBlock Text="{Binding RegistryErrors}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource TaskCardTemplate}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Идеи -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid" BasedOn="{StaticResource PageHost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsIdeasPage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <views:PageHeaderView Title="Рилсы"/>
                                <StackPanel Style="{StaticResource SettingsPanel}">
                                    <views:JsonSettingsView DataContext="{Binding ReelsSettings}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource ContentPanel}">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding IsReelsBusy, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ctl:ActivityOrb Width="26" Height="26" Kind="Composing" Foreground="{StaticResource WorkingBrush}" Margin="-4,-2,12,-2"/>
                                        <TextBlock Text="Бот разбирает рилс, идея появится здесь через пару минут" Style="{StaticResource PageHint}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Visibility="{Binding IsIdeasEmpty, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Идей пока нет" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource PageHint}" Margin="0,8,0,0"
                                                   Text="Пришли боту в Telegram ссылку на рилс. Через пару минут здесь появится идея с названием и разбором. «Делаем» открывает Claude Code с готовой просьбой, которую ты отправляешь сам. Идея остаётся в списке, пока ты её не удалишь."/>
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Ideas}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                <StackPanel Orientation="Horizontal" Visibility="{Binding HasAuthor, Converter={StaticResource BoolToVisibility}}">
                                                                    <TextBlock Text="{Binding Author}" Style="{StaticResource PageHint}"/>
                                                                    <Border Style="{StaticResource VBar}"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding When}" Style="{StaticResource PageHint}" Margin="12,0,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Style="{StaticResource ToneBadge}" Padding="10,5,14,5" Margin="12,0,0,0" VerticalAlignment="Top">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ctl:ActivityOrb Width="18" Height="18" Style="{StaticResource ActivityOrb}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Status}" Style="{StaticResource ToneBadgeText}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Sections}" Margin="0,12,0,0" Visibility="{Binding HasSections, Converter={StaticResource BoolToVisibility}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border x:Name="Section" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,10">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource TextBody}" Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{Binding Text}" Style="{StaticResource TextBody}" TextWrapping="Wrap" TextAlignment="Justify" LineHeight="21" Margin="0,3,0,0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding Preview}" Style="{StaticResource PageHint}" Margin="0,8,0,0" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                                                               Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                        <Button Content="Делаем" Command="{Binding ApproveCommand}" Style="{StaticResource PrimaryButton}"/>
                                                        <Button Content="Удалить" Command="{Binding RejectCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                                                        <Button Content="Открыть рилс" Command="{Binding OpenSourceCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Почта -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid" BasedOn="{StaticResource PageHost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMailPage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,12,0">
                                <views:PageHeaderView Title="Почта"/>
                                <StackPanel Style="{StaticResource SettingsPanel}">
                                    <views:JsonSettingsView DataContext="{Binding MailSettings}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource ContentPanel}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Card}" Margin="0,0,8,0" VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Text="Проверок за неделю" Style="{StaticResource TextCaption}"/>
                                            <TextBlock Text="{Binding MailChecksCount}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeHeadline}" FontWeight="SemiBold" Margin="0,4,0,8"/>
                                            <TextBlock Text="Последняя" Style="{StaticResource TextCaption}"/>
                                            <TextBlock Text="{Binding MailLastCheck}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Разобрано писем по дням" Style="{StaticResource TextCaption}"/>
                                            <ItemsControl ItemsSource="{Binding MailDays}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Height="92">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding Value}" Style="{StaticResource TextCaption}" HorizontalAlignment="Center"/>
                                                                <Border Width="22" Height="{Binding Height}" Background="{StaticResource AccentBrush}" CornerRadius="3,3,0,0" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Row="1" Text="{Binding Label}" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="По видам" Style="{StaticResource TextCaption}"/>
                                            <ItemsControl ItemsSource="{Binding MailKinds}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,10">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeBody}"/>
                                                                <TextBlock Text="{Binding Value}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeBody}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            <ProgressBar Value="{Binding Share, Mode=OneWay}" Margin="0,4,0,0">
                                                                <ProgressBar.Style>
                                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource ThinProgress}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelToneEnum.Attention}">
                                                                                <Setter Property="Foreground" Value="{StaticResource AttentionBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelToneEnum.Idle}">
                                                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ProgressBar.Style>
                                                            </ProgressBar>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Что разобрано последним" Style="{StaticResource TextTitle}" Margin="4,16,0,8"/>
                                <TextBlock Style="{StaticResource PageHint}" TextWrapping="Wrap" Margin="4,0,0,8"
                                           Text="Каждое письмо от человека или с отзывом превращается в задачу в Singularity. Здесь письма из последних проверок."/>
                                <ItemsControl ItemsSource="{Binding MailLetters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="Stripe" Background="{StaticResource LineStrongBrush}" CornerRadius="2" Margin="8,10,0,10"/>
                                                    <StackPanel Grid.Column="1" Margin="14,10,14,10">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Subject}" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeBodyLarge}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                            <Border Style="{StaticResource ToneBadge}" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Kind}" Style="{StaticResource ToneBadgeText}" FontSize="{StaticResource FontSizeCaption}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Meta}" Style="{StaticResource TextCaption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0"
                                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="Открыть письмо" Command="{Binding OpenCommand}" Style="{StaticResource OutlineButton}" VerticalAlignment="Center" Margin="0,0,14,0"
                                                            Visibility="{Binding HasLink, Converter={StaticResource BoolToVisibility}}"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelToneEnum.Attention}">
                                                    <Setter TargetName="Stripe" Property="Background" Value="{StaticResource AttentionBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelToneEnum.Running}">
                                                    <Setter TargetName="Stripe" Property="Background" Value="{StaticResource OkBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Расписание -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid" BasedOn="{StaticResource PageHost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSchedulePage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,12,0">
                                <views:PageHeaderView Title="Расписание"/>
                                <StackPanel Style="{StaticResource SettingsPanel}">
                                    <views:ScheduleSettingsView DataContext="{Binding Settings}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Расшифровки -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid" BasedOn="{StaticResource PageHost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTranscriptsPage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,12,0">
                                <views:PageHeaderView Title="Автоматизация образования"/>
                                <StackPanel Style="{StaticResource SettingsPanel}">
                                    <views:JsonSettingsView DataContext="{Binding LmsSettings}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource ContentPanel}">
                                    <views:HomeworkFormatsView DataContext="{Binding Formats}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Журнал -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid" BasedOn="{StaticResource PageHost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsJournalPage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,12,0">
                                <Grid Margin="0,0,0,20">
                                    <TextBlock Text="Журнал" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
                                    <Button Content="Очистить журнал" Style="{StaticResource OutlineButton}" HorizontalAlignment="Right"
                                            Command="{Binding ClearJournalCommand}" Visibility="{Binding HasRecords, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                                <TextBlock Text="Записей пока нет" Style="{StaticResource PageHint}" Margin="4,0,0,0"
                                           Visibility="{Binding IsJournalEmpty, Converter={StaticResource BoolToVisibility}}"/>
                                <ItemsControl ItemsSource="{Binding Groups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="8,6,8,8" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <Grid>
                                                        <ToggleButton IsChecked="{Binding IsOpen, Mode=TwoWay}" Style="{StaticResource SectionToggle}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ctl:ActivityOrb Width="26" Height="26" Style="{StaticResource StatusOrb}" Margin="0,0,12,0"/>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" Style="{StaticResource TextTitle}"/>
                                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource TextCaption}" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                        <Button Content="Очистить вкладку" Style="{StaticResource OutlineButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,48,0" Padding="12,5" Command="{Binding ClearCommand}"/>
                                                    </Grid>
                                                    <ctl:CollapsibleBody Style="{StaticResource CollapsibleBody}" IsOpen="{Binding IsOpen}">
                                                        <StackPanel Margin="4,0,4,0">
                                                            <ItemsControl ItemsSource="{Binding Runs}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Style="{StaticResource Card}" Background="Transparent" Padding="16,12" Margin="0,8,0,0">
                                                                            <StackPanel>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding When}" Style="{StaticResource TextBodyLarge}" FontWeight="SemiBold"/>
                                                                                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasRepeats, Converter={StaticResource BoolToVisibility}}">
                                                                                            <Border Style="{StaticResource VBar}"/>
                                                                                            <TextBlock Text="{Binding Repeats}" Style="{StaticResource TextCaption}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                                                        </StackPanel>
                                                                                        <Border Style="{StaticResource VBar}"/>
                                                                                        <Border x:Name="ReasonChip" Style="{StaticResource Chip}" Margin="12,0,0,0" VerticalAlignment="Center">
                                                                                            <TextBlock x:Name="ReasonText" Text="{Binding Reason}" Style="{StaticResource TextCaption}"/>
                                                                                        </Border>
                                                                                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasFacts, Converter={StaticResource BoolToVisibility}}">
                                                                                            <Border Style="{StaticResource VBar}"/>
                                                                                            <TextBlock Text="{Binding Facts}" Style="{StaticResource TextCaption}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                                                        </StackPanel>
                                                                                    </StackPanel>
                                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                                        <Border Style="{StaticResource ToneBadge}" Padding="14,8" VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding Outcome}" Style="{StaticResource ToneBadgeText}"/>
                                                                                        </Border>
                                                                                        <Button Content="Починить с Claude" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                                                Command="{Binding FixCommand}" Visibility="{Binding CanFix, Converter={StaticResource BoolToVisibility}}"/>
                                                                                        <Button Style="{StaticResource RemoveButton}" Command="{Binding RemoveCommand}"/>
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                                <ItemsControl ItemsSource="{Binding SummaryLines}" Margin="0,10,0,0" Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Border Style="{StaticResource LogLine}">
                                                                                                <Grid>
                                                                                                    <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                    </Grid.ColumnDefinitions>
                                                                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource TextMono}" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0"/>
                                                                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource TextMono}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                                                                                </Grid>
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                                <Border Style="{StaticResource ReasonBlock}" Margin="0,10,0,0" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                                                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource TextBody}" TextWrapping="Wrap"/>
                                                                                </Border>
                                                                                <ItemsControl ItemsSource="{Binding OutputLines}" Margin="0,10,0,0"
                                                                                              Visibility="{Binding HasOutput, Converter={StaticResource BoolToVisibility}}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Border Style="{StaticResource LogLine}">
                                                                                                <Grid>
                                                                                                    <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                    </Grid.ColumnDefinitions>
                                                                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource TextMono}" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0"/>
                                                                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource TextMono}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                                                                                </Grid>
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <DataTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding IsManual}" Value="True">
                                                                                <Setter TargetName="ReasonChip" Property="BorderBrush" Value="{StaticResource AccentTextBrush}"/>
                                                                                <Setter TargetName="ReasonText" Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
                                                                            </DataTrigger>
                                                                        </DataTemplate.Triggers>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <ItemsControl ItemsSource="{Binding Checks}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Style="{StaticResource Card}" Background="Transparent" Padding="16,12" Margin="0,8,0,0">
                                                                            <StackPanel>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding When}" Style="{StaticResource TextBodyLarge}" FontWeight="SemiBold"/>
                                                                                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasRepeats, Converter={StaticResource BoolToVisibility}}">
                                                                                            <Border Style="{StaticResource VBar}"/>
                                                                                            <TextBlock Text="{Binding Repeats}" Style="{StaticResource TextCaption}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                                                        </StackPanel>
                                                                                        <Border Style="{StaticResource VBar}"/>
                                                                                        <Border Style="{StaticResource Chip}" Margin="12,0,0,0" VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource TextCaption}"/>
                                                                                        </Border>
                                                                                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasFacts, Converter={StaticResource BoolToVisibility}}">
                                                                                            <Border Style="{StaticResource VBar}"/>
                                                                                            <TextBlock Text="{Binding Facts}" Style="{StaticResource TextCaption}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                                                        </StackPanel>
                                                                                    </StackPanel>
                                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                                        <Border Style="{StaticResource ToneBadge}" Padding="14,6" VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding Outcome}" Style="{StaticResource ToneBadgeText}"/>
                                                                                        </Border>
                                                                                        <Button Style="{StaticResource RemoveButton}" Command="{Binding RemoveCommand}"/>
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                                <ItemsControl ItemsSource="{Binding OutputLines}" Margin="0,10,0,0">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Border Style="{StaticResource LogLine}">
                                                                                                <Grid>
                                                                                                    <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                    </Grid.ColumnDefinitions>
                                                                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource TextMono}" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0"/>
                                                                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource TextMono}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                                                                                </Grid>
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Grid Margin="0,12,0,4" Visibility="{Binding HasPaging, Converter={StaticResource BoolToVisibility}}">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                    <TextBlock Text="Показывать по" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Margin="4,0,8,0"/>
                                                                    <ComboBox Style="{StaticResource FieldChoice}" Width="76" Margin="0" ItemsSource="{x:Static vm:JournalGroupViewModel.PageSizes}"
                                                                              SelectedItem="{Binding PageSize, Mode=TwoWay}"/>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource OutlineButton}" Padding="12,6" Command="{Binding PreviousCommand}" ToolTip="Назад"
                                                                            FontFamily="Segoe MDL2 Assets" Content="&#xE76B;"/>
                                                                    <TextBlock Text="{Binding PageLabel}" Style="{StaticResource TextBody}" VerticalAlignment="Center" Margin="14,0"/>
                                                                    <Button Style="{StaticResource OutlineButton}" Padding="12,6" Command="{Binding NextCommand}" ToolTip="Вперёд"
                                                                            FontFamily="Segoe MDL2 Assets" Content="&#xE76C;"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </ctl:CollapsibleBody>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
