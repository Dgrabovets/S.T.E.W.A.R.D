<Window x:Class="Steward.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Steward.Models"
        Title="Задачи"
        Width="1020"
        Height="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0,0,4"/>
        </Style>

        <Style x:Key="PageHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
        </Style>

        <Style x:Key="PageHost" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="#080612"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="22" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="16">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#2A2144" Offset="0"/>
                <GradientStop Color="#1C1630" Offset="0.22"/>
                <GradientStop Color="#1C1630" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Margin="24,16,14,8" Background="Transparent" MouseLeftButtonDown="TitleBar_OnDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Steward" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="12" Padding="14,6" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelTone.Running}">
                                    <Setter Property="Background" Value="#203A34"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelTone.Attention}">
                                    <Setter Property="Background" Value="{StaticResource AttentionSurfaceBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelTone.Problem}">
                                    <Setter Property="Background" Value="{StaticResource DangerSurfaceBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusLabel}" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource IdleBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelTone.Running}">
                                        <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelTone.Attention}">
                                        <Setter Property="Foreground" Value="{StaticResource AttentionBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelTone.Problem}">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <Button Grid.Column="2" Content="—" Style="{StaticResource GhostButton}" Click="Minimize_OnClick" ToolTip="Свернуть"/>
                <Button Grid.Column="3" Content="✕" Style="{StaticResource GhostButton}" Click="Close_OnClick" ToolTip="Скрыть в трей"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Margin="16,8,8,16">
                    <StackPanel>
                        <RadioButton GroupName="Nav" Content="Статус" Style="{StaticResource NavButton}" IsChecked="{Binding IsStatusPage, Mode=TwoWay}"/>
                        <RadioButton GroupName="Nav" Content="Идеи" Style="{StaticResource NavButton}" IsChecked="{Binding IsIdeasPage, Mode=TwoWay}"/>
                        <RadioButton GroupName="Nav" Content="ДЗ" Style="{StaticResource NavButton}" IsChecked="{Binding IsHomeworkPage, Mode=TwoWay}"/>
                        <RadioButton GroupName="Nav" Content="Журнал" Style="{StaticResource NavButton}" IsChecked="{Binding IsJournalPage, Mode=TwoWay}"/>
                    </StackPanel>
                    <Button Content="Выход" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Command="{Binding ExitCommand}"/>
                </Grid>

                <Grid Grid.Column="1" Margin="8,4,24,24">
                    <!-- Статус -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid" BasedOn="{StaticResource PageHost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusPage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Задачи" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Всё, что приложение запускает или за чем следит. Статус обновляется сам." Style="{StaticResource PageHint}" Margin="4,0,0,16"/>
                                <Border Style="{StaticResource Card}" Background="{StaticResource AttentionSurfaceBrush}"
                                        Visibility="{Binding HasRegistryErrors, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="В config/jobs.json есть ошибки" Foreground="{StaticResource AttentionBrush}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding RegistryErrors}" Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Card" Style="{StaticResource Card}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse x:Name="Dot" Width="12" Height="12" Fill="{StaticResource IdleBrush}" VerticalAlignment="Top" Margin="0,5,14,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="Name" Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Headline}" Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="12,2,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="13.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                    <Button x:Name="Run" Grid.Column="2" Content="Запустить" Style="{StaticResource ActionButton}" Margin="12,0,0,0"
                                                            VerticalAlignment="Top" Command="{Binding RunCommand}" Visibility="Collapsed"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding CanRun}" Value="True">
                                                    <Setter TargetName="Run" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Muted}" Value="True">
                                                    <Setter TargetName="Card" Property="Opacity" Value="0.7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelTone.Running}">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource OkBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelTone.Attention}">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AttentionBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelTone.Problem}">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                    <Setter TargetName="Card" Property="Background" Value="{StaticResource DangerSurfaceBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Идеи -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid" BasedOn="{StaticResource PageHost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsIdeasPage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel>
                            <TextBlock Text="Идеи" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Разобранные идеи из сохранённых рилсов, которые ждут твоего решения." Style="{StaticResource PageHint}" Margin="4,0,0,16"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Идей пока нет" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource PageHint}" Margin="0,8,0,0"
                                               Text="Сюда попадут идеи из рилсов, которыми ты поделишься с ботом. У каждой будет подробное описание и кнопки «Делаем» и «Отклонить». Если принять идею, приложение запустит Claude Code, и он реализует её в отдельной ветке git, а ты проверишь результат."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ДЗ -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid" BasedOn="{StaticResource PageHost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHomeworkPage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel>
                            <TextBlock Text="Домашние задания" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Черновики, которые подготовил агент. Сдаёшь работу всегда ты сам." Style="{StaticResource PageHint}" Margin="4,0,0,16"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Черновиков пока нет" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource PageHint}" Margin="0,8,0,0"
                                               Text="После занятий здесь появятся записи «Подготовлено ДЗ». Кнопка «Просмотреть» откроет черновик в VS Code, а «Сформировать Word» соберёт документ по методическим указаниям."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Журнал -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid" BasedOn="{StaticResource PageHost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsJournalPage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Журнал запусков" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Что приложение запускало и чем это закончилось. Последние сто записей." Style="{StaticResource PageHint}" Margin="4,0,0,16"/>
                                <TextBlock Text="Запусков пока не было" Style="{StaticResource PageHint}" Margin="4,0,0,0"
                                           Visibility="{Binding IsJournalEmpty, Converter={StaticResource BoolToVisibility}}"/>
                                <ItemsControl ItemsSource="{Binding Records}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{StaticResource IdleBrush}" VerticalAlignment="Top" Margin="0,6,12,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Outcome}" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="10,1,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,3,0,0">
                                                            <Run Text="{Binding When, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Reason, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                                                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelTone.Running}">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource OkBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:PanelTone.Problem}">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource DangerSurfaceBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
