<UserControl x:Class="Steward.Views.NavTabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Steward.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ctl:ActivityOrb Width="24" Height="24" Style="{StaticResource ActivityOrb}" Margin="-4,-4,10,-4" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <Border Grid.Column="2" Background="{StaticResource AttentionSurfaceBrush}" CornerRadius="{StaticResource RadiusBadge}" Padding="8,1" VerticalAlignment="Center" Margin="8,0,0,0"
                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Badge}" Foreground="{StaticResource AttentionBrush}" FontSize="{StaticResource FontSizeCaption}"/>
        </Border>
    </Grid>
</UserControl>
