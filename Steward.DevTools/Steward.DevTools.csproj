<Project Sdk="Microsoft.NET.Sdk">

  <!-- Инструменты разработчика: рисуют окна приложения в PNG, собирают значки и страницу-образец дизайн-системы. В приложение не входят -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Steward.DevTools</RootNamespace>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Скрипты запускаются отдельно, в проект не собираются -->
    <Compile Remove="Scripts\**" />
    <None Include="Scripts\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Steward\Steward.csproj" />
  </ItemGroup>

</Project>
