{
  // Задачи, которые приложение в трее запускает само и статус которых показывает.
  // {repo} заменяется корнем репозитория. Расписание пар сюда не входит: им занимается Docker.
  // Условия запуска: start (при запуске приложения), daily (каждый день в HH:mm), interval (через N минут).
  "jobs": [
    {
      "id": "mail",
      "title": "Почта",
      // Нужны настроенный Steward.Mail/appsettings.json и собранная программа:
      //   dotnet publish Steward.Mail -c Release -o Steward.Mail/publish
      // Письма читаются без отметки «прочитано», задачи не дублируются (внешний ключ в Singularity)
      "enabled": true,
      "command": "{repo}\\Steward.Mail\\publish\\Steward.Mail.exe",
      "triggers": [
        { "type": "start" },
        { "type": "daily", "at": "09:00" },
        { "type": "daily", "at": "19:00" }
      ],
      "timeoutMinutes": 10,
      "staleAfterMinutes": 960
    },
    {
      "id": "homework",
      "title": "Домашние задания",
      // Создаёт задачи SingularityApp по заданиям, которые агент записал в data/homework/items/<занятие>.json.
      // Нужны Steward.Homework.Tasks/publish/appsettings.json с токеном и собранная программа:
      //   dotnet publish Steward.Homework.Tasks -c Release -o Steward.Homework.Tasks/publish
      "enabled": false,
      "command": "{repo}\\Steward.Homework.Tasks\\publish\\Steward.Homework.Tasks.exe",
      "triggers": [
        { "type": "start" },
        { "type": "daily", "at": "20:00" }
      ],
      "timeoutMinutes": 10,
      "staleAfterMinutes": 1500
    }
  ]
}
