# Токен из личного кабинета Singularity: доступ к сущностям «Проект» и «Задача» на чтение и запись
SINGULARITY_TOKEN=

# Идентификатор таблицы из её адреса и номер листа из параметра gid
SPREADSHEET_ID=
SHEET_GID=

# Заголовок колонки группы и название проекта, в который попадают пары
GROUP_COLUMN=РКИ-2-26
PROJECT_TITLE=Расписание

# Часовой пояс, в котором в таблице указано время
TIME_ZONE=Europe/Moscow

# Пауза между сверками в минутах
SYNC_INTERVAL_MINUTES=5

# Необязательно: идентификатор проекта (P-...), внутри которого создаётся проект расписания, если его ещё нет
# PROJECT_PARENT_ID=

# Необязательно: true ставит на пару тег с названием предмета. Токену нужен доступ к сущности «Тег» на чтение и запись
# SUBJECT_TAGS=true
